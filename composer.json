{
    "name": "mobtitude/zendframework1",
    "description": "Zend Framework 1 fork compatible with PHP 7.2 by Mobtitude",
    "type": "library",
    "keywords": [
        "framework",
        "zf1",
        "php-7.4"
    ],
    "homepage": "https://github.com/mobtitude/zendframework1",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^7.4"
    },
    "autoload": {
        "psr-0": {
            "Zend_": "library/"
        }
    },
    "include-path": [
        "library/"
    ],
    "config": {
        "bin-dir": "bin"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.12.x-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "3.7.*",
        "phpunit/dbunit": "1.3.*",
        "rector/rector": "^0.11.53",
        "ps-foundation/ps-ci-utils": "^0.2.3"
    },
    "archive": {
        "exclude": ["/demos", "/documentation", "/tests"]
    },
    "repositories": [{
        "type": "composer",
        "url": "https://composer:Y7VEZjvHvjHP@packages.rcdev.pl"
    }]
}
