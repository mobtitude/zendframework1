{
    "name": "mobtitude/zendframework1",
    "description": "Zend Framework 1 fork compatible with PHP 8.1 by Mobtitude",
    "type": "library",
    "keywords": [
        "framework",
        "zf1",
        "php-8.1"
    ],
    "homepage": "https://github.com/mobtitude/zendframework1",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-0": {
            "Zend_": "library/"
        }
    },
    "include-path": [
        "library/"
    ],
    "config": {
        "bin-dir": "bin"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.12.x-dev"
        }
    },
    "require-dev": {
        "rector/rector": "^0.12.17",
        "phpunit/phpunit": "3.7.*",
        "phpunit/dbunit": "1.3.*"
    },
    "archive": {
        "exclude": ["/demos", "/documentation", "/tests"]
    }
}
